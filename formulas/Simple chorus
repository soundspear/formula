    "Source": "\/*\r\n    Author or source: antoinec <antoine.champion+dsp@outlook.fr>\r\n*\/\r\n\r\n\/* Simple chorus made using a multi voices flanger.\r\n * Each voice has a phase offset in addition of the \r\n * initial delay. *\/\r\n\r\nfloat buffer[1000000];\r\nfloat bufferLength = 1000000;\r\nint writePtr = 0;\r\nfloat phase = 0;\r\n\r\n\/\/ Linear interpolation in an circular array \r\nfloat lerp_circular(float* arr, int arrSize, int from, float fract) {\r\n    int to = (from + 1) % arrSize;\r\n      \r\n    return (1-fract)*buffer[from] + fract*buffer[to];\r\n}\r\n\nformula_main {\r\n    float frequency = 2 * KNOB_1; \r\n    float width = 0.001 + KNOB_2 * 0.02;\r\n    float depth = KNOB_3;\r\n    int voices = 1 + KNOB_4 * 10;\r\n    \r\n    float output = input;\r\n    for (int v = 1; v < voices; v++) {\r\n        float voicePhase = v * 0.6;\r\n        float voiceDelay = 0.01 + width * (0.5 + 0.5*sin(2.0 * M_PI * (phase + voicePhase)));\r\n        float bufferReadPtr = fmodf((float)writePtr - voiceDelay * SAMPLE_RATE + bufferLength - 3.0, (float)bufferLength);\r\n    \r\n        float fract = bufferReadPtr - (int)(bufferReadPtr); \r\n        float interpolated = lerp_circular(buffer, bufferLength, bufferReadPtr, fract);\r\n        output += depth * interpolated * 2 \/ voices;\r\n    }\r\n    \r\n    buffer[writePtr++] = input;\r\n    if (writePtr >= bufferLength) {\r\n        writePtr = 0;\r\n    }\r\n    \r\n    phase += frequency \/ SAMPLE_RATE;\r\n    if (phase > 1.0) {\r\n        phase -= 1;\r\n    }\r\n    \n    return output;\n}\n",
