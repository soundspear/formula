    "Source": "\/*\r\n    Author or source: antoinec <antoine.champion+dsp@outlook.fr>\r\n*\/\r\n\r\n\/* Flanger\r\n * A flanger is created by playing two versions of the same\r\n * track at a slightly different modulated speed, which can be\r\n * represented as a modulated comb filter.\r\n *\/\r\n\r\nfloat buffer[1000000];\r\nfloat bufferLength = 1000000;\r\nint writePtr = 0;\r\nfloat phase = 0;\r\n\r\n\/\/ Linear interpolation in an circular array \r\nfloat lerp_circular(float* arr, int arrSize, int from, float fract) {\r\n    int to = (from + 1) % arrSize;\r\n      \r\n    return (1-fract)*buffer[from] + fract*buffer[to];\r\n}\r\n\nformula_main {\r\n    float frequency = exp(KNOB_1*3.0);    \r\n    float width = KNOB_2 * 0.01;\r\n    float depth = KNOB_3;\r\n    float feedback = KNOB_4 * 0.95;\r\n    int isStatic = SWITCH_1;\r\n    if (isStatic) {\r\n        frequency = 0;\r\n    }\r\n    \r\n    float delay = width * (0.5 + 0.5*sin(2.0 * M_PI * phase));\r\n    float bufferReadPtr = fmodf((float)writePtr - delay * SAMPLE_RATE + bufferLength - 3.0, (float)bufferLength);\r\n    \r\n    float fract = bufferReadPtr - (int)(bufferReadPtr); \r\n    float interpolated = lerp_circular(buffer, bufferLength, bufferReadPtr, fract);\r\n    \r\n    buffer[writePtr++] = input + (interpolated * feedback);\r\n    if (writePtr >= bufferLength) {\r\n        writePtr = 0;\r\n    }\r\n    \r\n    phase += frequency \/ SAMPLE_RATE;\r\n    if (phase > 1.0) {\r\n        phase -= 1;\r\n    }\r\n    \n    return input + depth * interpolated;\n}\n",
