    "Source": "\/*\r\n    Author or source: antoinec <antoine.champion+dsp@outlook.fr>\r\n*\/\r\n\r\n\r\ntypedef struct {\r\n    double thres, ratio, atk, rel;\r\n    double makeup, rmsSize;\r\n\r\n    double rmsBuf[10000];\r\n    double rmsSum; \r\n\tint rmsPtr;\r\n    double yold;\r\n} CompState;\r\n\r\ntypedef struct {\r\n    float c[2][2][6];\r\n    float zIn[2][2][2];\r\n    float zOut[2][2][2];\r\n} LRState;\r\n\r\nint xoverInitialized = 0;\r\n\r\nfloat prevKnobs[3] = {-1};\r\n\r\nLRState xbass = {{0}};\r\nLRState xhigh = {{0}};\r\nCompState compBass = {{0}}, compMid = {{0}}, compHigh = {{0}};\r\n\r\nfloat computeRms(float input, CompState* s) {\r\n    s->rmsSum -= s->rmsBuf[s->rmsPtr];\r\n    s->rmsBuf[s->rmsPtr] = input*input\/s->rmsSize;    \r\n    s->rmsSum += s->rmsBuf[s->rmsPtr++];\r\n    \r\n    if (s->rmsPtr > s->rmsSize) {\r\n        s->rmsPtr = 0;\r\n    }\r\n    \r\n    float rms = sqrt(s->rmsSum);\r\n\t\r\n\treturn rms;\r\n}\r\n\r\nfloat compress(float input, CompState* s) {    \r\n    double rms = computeRms(input, s);  \r\n    \r\n    double x = fabs(rms);\r\n    double cte = x < s->yold ? s->atk : s->rel;\r\n    double y = x + cte * (s->yold - x);\r\n    s->yold = y;\r\n    \r\n    double gain = 1.0;\r\n    if (y < s->thres) {\r\n        gain = pow (y \/ s->thres, 1.0 \/ s->ratio - 1.0);\r\n    }    \r\n    \r\n    return gain * input * s->makeup; \r\n}\r\n\r\nvoid updateComp(CompState* s, float thresDb, float ratio, float atkMs, float relMs, float makeupDb, float rmsSize) {\r\n    s->thres = pow (10.0, thresDb * 0.05);\r\n    s->ratio = ratio;\r\n    double scaling = -2.0 * M_PI * 1000.0 \/ SAMPLE_RATE;\r\n    s->atk = exp(scaling \/ atkMs);\r\n    s->rel = exp(scaling \/ relMs);\r\n    s->makeup = pow (10.0, makeupDb * 0.05);\r\n    s->rmsSize = rmsSize;\r\n}\r\n\r\nLRState xOver(float input, float* outLow, float* outHigh, LRState state) {\r\n    \r\n    float inLow = input;\r\n    for (int order = 0; order < 2; order++) {\r\n        float *a = state.c[0][order], *b = state.c[0][order] + 3;\r\n        float *i = state.zIn[0][order], *o = state.zOut[0][order];\r\n        *outLow = (b[0]*inLow + b[1]*i[0] + b[2]*i[1] - a[1]*o[0] - a[2]*o[1]) \/ a[0];\r\n        i[1] = i[0]; i[0] = inLow;\r\n        o[1] = o[0]; o[0] = *outLow;\r\n        inLow = *outLow;\r\n    }\r\n    \r\n    float inHigh = input;\r\n    for (int order = 0; order < 2; order++) {\r\n        float *a = state.c[1][order], *b = state.c[1][order] + 3;\r\n        float *i = state.zIn[1][order], *o = state.zOut[1][order];\r\n        *outHigh = (b[0]*inHigh + b[1]*i[0] + b[2]*i[1] - a[1]*o[0] - a[2]*o[1]) \/ a[0];\r\n        i[1] = i[0]; i[0] = inHigh;\r\n        o[1] = o[0]; o[0] = *outHigh;\r\n        inHigh = *outHigh;\r\n    }\r\n    return state;\r\n}\r\n\r\nLRState lr4(float cutoff, LRState state) {\r\n    float Q = 1 \/ sqrt(2);\r\n    for (int i = 0; i < 2; ++i)\r\n    {\r\n        float w0 = 2 * M_PI * cutoff \/ SAMPLE_RATE;\r\n        float alpha = sin(w0) \/ (2*Q);\r\n        float cw = cos(w0);\r\n        \r\n        state.c[1][i][0] = state.c[0][i][0] = 1 + alpha;\r\n        state.c[1][i][1] = state.c[0][i][1] = -2 * cw;\r\n        state.c[1][i][2] = state.c[0][i][2] = 1 - alpha;        \r\n        state.c[0][i][3] = 0.5 * (1 - cw);\r\n        state.c[1][i][3] = 0.5 * (1 + cw);\r\n        state.c[0][i][4] = 1 - cw;\r\n        state.c[1][i][4] = -1 - cw;\r\n        state.c[0][i][5] = 0.5 * (1 - cw);\r\n        state.c[1][i][5] = 0.5 * (1 + cw);\r\n    }\r\n    \r\n    return state;\r\n}\r\n\r\nint checkKnobsChanged() {\r\n    int changed = 0;\r\n    float knobs[3] = {\r\n        KNOB_1, KNOB_2, KNOB_3\r\n    };\r\n    \r\n    for (int i = 0; i < 4; i++) {\r\n        changed += knobs[i] != prevKnobs[i];\r\n        prevKnobs[i] = knobs[i];\r\n    }\r\n    return changed;\r\n}\r\n\r\nformula_main {\r\n\r\n    if (checkKnobsChanged()) {\r\n        xbass = lr4(150+KNOB_2*500, xbass);\r\n        xhigh = lr4(4000-KNOB_2*3000, xhigh);\r\n        updateComp(&compBass, (1-KNOB_1)*-30, 2, \r\n                3 + KNOB_3*20, 10+KNOB_3*200, \r\n                (KNOB_1) * 1, 1);\r\n        updateComp(&compMid, (1-KNOB_1)*-30, 2, \r\n                1 + KNOB_3*10, 10+KNOB_3*100, \r\n                (KNOB_1) * -5, 1);\r\n        updateComp(&compHigh, (1-KNOB_1)*-30, 5, \r\n                3 + KNOB_3*50, 10+KNOB_3*500, \r\n                (0.3 + KNOB_1) * -13, 1);  \r\n    }\r\n    \r\n    float bass, mid, high;\r\n    \r\n    xbass = xOver(input,  &bass, &mid, xbass);\r\n    xhigh = xOver(mid, &mid, &high, xhigh);    \r\n    \r\n    bass = compress(bass, &compBass);    \r\n    mid = compress(mid, &compMid);\r\n    high = compress(high, &compHigh);\r\n    \r\n    return (bass + mid + high) * (1-KNOB_1*0.7);\r\n}\r\n",
