    "Source": "\/*\r\n    Author or source: antoinec <antoine.champion+dsp@outlook.fr>\r\n*\/\r\n\r\n\/* Feedback delay with a damping control to attenuate\r\n * the high frequencies of the delayed sound *\/\r\n\r\nfloat filterBuffer = 0;\r\nfloat delayBuffer[1000000];\r\nint bufferPtr = 0;\r\n\r\n\/\/ Low pass filtering\r\nfloat damp(float amount, float input) {\r\n\r\n    float frequency = exp(amount*10);\r\n    float coeff = 2 * M_PI * frequency \/ SAMPLE_RATE;\r\n    coeff = coeff \/ (1 + coeff);\r\n    \r\n    float damped = coeff * input + (1 - coeff) * filterBuffer;\r\n    filterBuffer = damped;\r\n    \r\n    return damped;\r\n}\r\n\nformula_main {\r\n    float output = delayBuffer[bufferPtr];\r\n    \r\n    int delayBufferSize = SAMPLE_RATE * KNOB_1;\r\n    float feedback = KNOB_2;\r\n    \r\n    float dampedOutput = damp(KNOB_3, output);\r\n    delayBuffer[bufferPtr] = input + dampedOutput * feedback;\r\n    \r\n    bufferPtr++;\r\n    if (bufferPtr > delayBufferSize) {\r\n        bufferPtr = 0;\r\n    }\r\n    \r\n    return output;\r\n}\n",
