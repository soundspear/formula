    "Source": "\/*\r\n    Author or source: antoinec <antoine.champion+dsp@outlook.fr>\r\n*\/\r\n\r\n\r\n\/* ---------------------\r\n\r\nSynthetizer generator. \r\nGenerates a synth wave at a given frequency \r\n\r\n*\/\r\n\r\nfloat synth(float freq) {\r\n\r\n    \/\/ CREATE YOUR OWN SYNTH WAVE HERE\r\n\r\n    \/\/ Placeholder: simple sawtooth\r\n    float output = freq*fmod(TIME, 1\/freq) \/ 2;\r\n    \r\n    return output;\r\n}\r\n\r\n\r\n\/* --------------------- *\/\r\n\r\n\r\n\r\n\r\n\/* Internal synth orchestration *\/\r\n\r\nfloat lerp(float x, float x1, float x2, float y1, float y2) {\r\n    return y1 + (x-x1) * (y2-y1) \/ (x2-x1) ;\r\n}\r\n\r\nfloat adsr(float sample, float t, float duration) {\r\n    float attackTime = 0.01;\r\n    float decayTime = 0.1;\r\n    float sustainGain = 0.7;\r\n    float releaseTime = 0.1;\r\n    \r\n    if (t < attackTime) {\r\n        sample *= lerp(t, 0, attackTime, 0, 1);\r\n    }    \r\n    else if (t < attackTime + decayTime) {\r\n        sample *= lerp(t, attackTime, attackTime + decayTime, 1, sustainGain);\r\n    }\r\n    else if (t < duration - releaseTime) {\r\n        sample *= sustainGain;\r\n    }\r\n    else {\r\n        sample *= lerp(t, duration - releaseTime, duration, sustainGain, 0);\r\n    }\r\n    return sample;\r\n}\r\n\nformula_main {\r\n    float output = 0;\r\n    \r\n    float noteLength = 0.5;\r\n    float time = fmod(TIME, noteLength * 6); \/\/ 3 notes, 3 pauses\r\n    \r\n    float noteTime;\r\n    \r\n    if (time < 0.5) {\r\n        output = synth(130.8); \/\/ C3\r\n        noteTime = time;\r\n    }\r\n    \r\n    else if (time > 1 && time < 1.5) {\r\n        output = synth(261.6); \/\/ C4  \r\n        noteTime = time - 1;\r\n    }\r\n    \r\n    else if (time > 2 && time < 2.5) {\r\n        output = synth(523.3); \/\/ C5  \r\n        noteTime = time - 2;\r\n    }\r\n    \r\n    output = adsr(output, noteTime, noteLength);\r\n    \n    return output;\n}\n",
