    "Source": "\/*\r\n    Author or source: antoinec <antoine.champion+dsp@outlook.fr>\r\n*\/\r\n\r\n\r\nformula_main_stereo {\r\n    float midDb = -12 + KNOB_1 * 24;\r\n    float sidesDb = -12 + KNOB_2 * 24;\r\n    float midAmount = pow(10, midDb * 0.05);\r\n    float sidesAmount = pow(10, sidesDb * 0.05);\r\n\r\n    float mid = input.left + input.right;\r\n    float sides = input.left - input.right;\r\n\r\n    mid = mid * midAmount;\r\n    sides = sides * sidesAmount;\r\n\r\n    input.left = (mid + sides) \/ 2;\r\n    input.right = (mid - sides) \/ 2;\r\n\r\n    return input;\r\n}",
