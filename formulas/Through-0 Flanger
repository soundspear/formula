    "Source": "\/*\r\n    Author or source: antoinec <antoine.champion+dsp@outlook.fr>\r\n*\/\r\n\r\n\/* Through-0 Flanger *\/\r\n\r\n\/* The idea is to not blend the input signal like a traditional\r\n * flanger but a delayed version of it that would be in phase\r\n * delay with the flanged version. That create a lot more\r\n * destructive interferences.\r\n *\/\r\n\r\nfloat buffer[1000000];\r\nfloat dryBuffer[1000000];\r\nint bufferLength = 1000000;\r\nint writePtr = 0;\r\nint dryReadPtr = 0;\r\nfloat phase = 0;\r\n\r\n\/\/ Linear interpolation in an circular array \r\nfloat lerp_circular(float* arr, int arrSize, int from, float fract) {\r\n    int to = (from + 1) % arrSize;\r\n      \r\n    return (1-fract)*buffer[from] + fract*buffer[to];\r\n}\r\n\nformula_main {\r\n    float width = KNOB_1 * 0.01;\r\n    float depth = KNOB_2;\r\n    float feedback = KNOB_3 * 0.95;\r\n    \r\n    float delay = width;\r\n    float bufferReadPtr = fmodf((float)writePtr - delay * SAMPLE_RATE + bufferLength - 3.0, (float)bufferLength);\r\n    \r\n    float fract = bufferReadPtr - (int)(bufferReadPtr); \r\n    float interpolated = lerp_circular(buffer, bufferLength, bufferReadPtr, fract);    \r\n    \r\n    int dryDelay = depth * 0.01 * SAMPLE_RATE;\r\n    int dryWritePtr = (dryReadPtr + dryDelay) % bufferLength;\r\n    dryBuffer[dryWritePtr] = input;\r\n    \n    float output = dryBuffer[dryReadPtr++] + depth * interpolated;\r\n    \r\n    buffer[writePtr++] = input + (interpolated * feedback);\r\n    if (writePtr >= bufferLength) {\r\n        writePtr = 0;\r\n    }\r\n    \r\n    if (dryReadPtr >= bufferLength) {\r\n        dryReadPtr = 0;\r\n    }\r\n    \r\n    return output;\n}\n",
