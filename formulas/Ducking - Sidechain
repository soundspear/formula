    "Source": "\/*\r\n    Author or source: antoinec <antoine.champion+dsp@outlook.fr>\r\n*\/\r\n\r\n\/*\r\n    Dynamically reduce the volume of your tracks on the beats\r\n*\/\r\n\r\nfloat lerp(float x, float x1, float x2, float y1, float y2) {\r\n    return y1 + (x-x1) * (y2-y1) \/ (x2-x1) ;\r\n}\r\n\r\n\r\nformula_main {\r\n    double beatSync;\r\n    if      (KNOB_1 < 0.125) beatSync = BAR \/ 3;\r\n    else if (KNOB_1 < 0.250) beatSync = BAR \/ 2;\r\n    else if (KNOB_1 < 0.375) beatSync = BAR \/ 1.5;\r\n    else if (KNOB_1 < 0.625) beatSync = BAR;\r\n    else if (KNOB_1 < 0.750) beatSync = BAR * 1.5;\r\n    else if (KNOB_1 < 0.875) beatSync = BAR * 2;\r\n    else                     beatSync = BAR * 3;\r\n    \r\n    const double fract = beatSync - (int)(beatSync);\r\n    \r\n    const double predelay = KNOB_2 * 0.30;\r\n    const double fadeOut = KNOB_4 * 0.20;\r\n    const double rampDuration = (1.0 - predelay) * KNOB_3;\r\n    \r\n    double duck;\r\n    \r\n    if (fract < predelay) duck = 0;\r\n    \r\n    else if (fract < predelay + rampDuration) {\r\n        duck = lerp(fract, predelay, predelay + rampDuration, 0, 1);\r\n    }\r\n    else if (fract < 1.0 - fadeOut) {\r\n        duck = 1;\r\n    }\r\n    else {\r\n        duck = lerp(fract, 1.0 - fadeOut, 1.0, 1.0, 0.0);\r\n    }\r\n    \r\n    return input * duck;\r\n}\r\n",
