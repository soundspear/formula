    "Source": "\/*\r\n    Author or source: patw\r\n*\/\r\n\r\nfloat panpot;\r\nint rDelay;\r\nint lDelay;\r\nfloat rVol;\r\nfloat lVol;\r\nfloat bl[50] = {0}; \/\/left buffer\r\nfloat br[50] = {0}; \/\/right buffer\r\nint bi = 0; \/\/buffer index\r\n\r\nformula_main_stereo {\r\n    \/\/set the pan knob so 0 is -1 and 1 is 1\r\n    panpot = (KNOB_1 - 0.5) * 2;\r\n    \/\/panpot -1 means right channel is delayed by 21 samples and vice versa\r\n    if (panpot == 0) {\r\n        rDelay = 0;\r\n        lDelay = 0;\r\n        rVol = 1;\r\n        lVol = 1;\r\n    }\r\n    else if (panpot > 0) {\r\n        rDelay = 0;\r\n        lDelay = panpot * 21;\r\n        rVol = 1;\r\n        lVol = 1 - (panpot \/ 1.5);\r\n    }\r\n    else if (panpot < 0) {\r\n        rDelay = panpot * -21;\r\n        lDelay = 0;\r\n        rVol = 1 - (panpot \/ -1.5);\r\n        lVol = 1;\r\n    }\r\n    \/\/increase the buffer index\r\n    bi++;\r\n    if (bi > 49) {\r\n        bi = 0;\r\n    }\r\n    \/\/fill the buffer with the input\r\n    bl[bi] = input.left;\r\n    br[bi] = input.right;\r\n    \/\/output the buffer at the current index position minus any delays, and multiply each channel output by its level modifier\r\n    Stereo output;\r\n    output.left = (bl[(bi + (50 - lDelay)) % 50]) * lVol;\r\n    output.right = (br[(bi + (50 - rDelay)) % 50]) * rVol;\n    return output;\n}",
