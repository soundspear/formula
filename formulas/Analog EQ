    "Source": "\/*\r\n    Author or source: antoinec <antoine.champion+dsp@outlook.fr>\r\n*\/\r\n\r\nvoid computeShelf(float frequency, float Q, float gain, int isHighShelf, float outCoefficients[6]) {\r\n    float w = 2 * M_PI * frequency \/ SAMPLE_RATE;\r\n\tgain = pow(10, gain * 0.05);\r\n    \r\n    float cw = cos(w);\r\n    float G = 1\/sqrt(gain);\r\n    float alpha = G * cw;\r\n    float beta = sin(w) * sqrt(G) \/ Q;\r\n    \r\n    float *a = outCoefficients;\r\n    float *b = outCoefficients + 3;\r\n    if (isHighShelf) {        \r\n        a[0] = G+1 - alpha + cw + beta;\r\n        a[1] = 2 * (G-1 - alpha - cw);\r\n        a[2] = G+1 - alpha + cw - beta;\r\n        b[0] = G * (G+1 + alpha - cw + beta);\r\n        b[1] = -2*G * (G-1 + alpha + cw);\r\n        b[2] = G * (G+1 + alpha - cw - beta);\r\n    \r\n    } else {\r\n        a[0] = G+1 + alpha - cw + beta;\r\n        a[1] = -2 * (G-1 + alpha + cw);\r\n        a[2] = G+1 + alpha - cw - beta;\r\n        b[0] = G * (G+1 - alpha + cw + beta);\r\n        b[1] = 2*G * (G-1 - alpha - cw);\r\n        b[2] = G * (G+1 - alpha + cw - beta);\r\n    }\r\n}\r\n\r\nfloat computePeak(float frequency, float Q, float gain, float outCoefficients[6]) {\r\n    float w = 2 * M_PI * frequency \/ SAMPLE_RATE;\r\n\tgain = pow(10, gain * 0.05);\r\n    \r\n    float cw = cos(w);\r\n    float sw = sin(w);\r\n    float G = 1\/sqrt(gain);\r\n    \r\n    float *a = outCoefficients;\r\n    float *b = outCoefficients + 3;\r\n    a[0] = 1 + sw\/(2*Q) \/ G, a[1] = -2*cw, a[2] = 1 - sw\/(2*Q) \/ G;    \r\n    b[0] = 1 + sw\/(2*Q) * G, b[1] = -2*cw, b[2] = 1 - sw\/(2*Q) * G;\r\n}\r\n\r\n\r\nfloat processFilter(float input, float coefficients[6], float zIn[2], float zOut[2]) {\r\n    float *a = coefficients;\r\n    float *b = coefficients + 3;\r\n    \r\n    float output = a[0]*input + a[1]*zIn[0] + a[2]*zIn[1];\r\n    output -= b[1]*zOut[0] + b[2]*zOut[1];\r\n    output \/= b[0];\r\n    \r\n    zIn[1] = zIn[0]; zIn[0] = input;\r\n    zOut[1] = zOut[0]; zOut[0] = output;\r\n    \r\n    return output;\r\n}\r\n\r\n\r\nfloat bassZIn[2] = {0}, midrangeZIn[2] = {0}, trebleZIn[2] = {0},\r\n      presenceZIn[2] = {0}, loudnessZIn[2][2] = {0};\r\nfloat bassZOut[2] = {0}, midrangeZOut[2] = {0}, trebleZOut[2] = {0},\r\n      presenceZOut[2] = {0}, loudnessZOut[2][2] = {0};\r\nfloat bassCoefficients[6] = {0}, midrangeCoefficients[6] = {0}, trebleCoefficients[6] = {0},\r\n      presenceCoefficients[6] = {0}, loudnessCoefficients[2][6] = {0};\r\n\r\nfloat bass = -1, midrange = -1, treble = -1, presence = -1, loudness = -1;\r\n\r\nformula_main {\r\n    if (KNOB_1 != bass) {\r\n        bass = KNOB_1;\r\n        \/\/ Low shelf\r\n        computeShelf(250, 0.7, -8 + bass * 16, 0, bassCoefficients);\r\n    }\r\n    \r\n    if (KNOB_2 != midrange) {\r\n        midrange = KNOB_2;\r\n        \/\/ Mid peak\r\n        computePeak(800, 0.3, -8 + midrange * 16, midrangeCoefficients);\r\n    }\r\n    \r\n    if (KNOB_3 != treble) {\r\n        treble = KNOB_3;\r\n        \/\/ High shelf\r\n        computeShelf(3000, 0.7, -8 + treble * 16, 1, trebleCoefficients);\r\n    }\r\n    \r\n    if (KNOB_4 != presence) {\r\n        presence = KNOB_4;\r\n        \/\/ Peak at the human ear sensitive high-mids\r\n        computePeak(4000, 1, -8 + presence * 16, presenceCoefficients);\r\n    }\r\n    \r\n    if (KNOB_5 != loudness) {\r\n        loudness = KNOB_5;\r\n        \/\/ Double shelf boost to increase perceived loudness\r\n        computeShelf(100, 1, -4 + loudness * 8, 0, loudnessCoefficients[0]);\r\n        computeShelf(8000, 1, -4 + loudness * 8, 1, loudnessCoefficients[1]);\r\n    }\r\n\r\n    float output = input;\r\n    output = processFilter(output, bassCoefficients, bassZIn, bassZOut);\r\n    output = processFilter(output, midrangeCoefficients, midrangeZIn, midrangeZOut);\r\n    output = processFilter(output, trebleCoefficients, trebleZIn, trebleZOut);\r\n    output = processFilter(output, presenceCoefficients, presenceZIn, presenceZOut);\r\n    output = processFilter(output, loudnessCoefficients[0], loudnessZIn[0], loudnessZOut[0]);\r\n    output = processFilter(output, loudnessCoefficients[1], loudnessZIn[1], loudnessZOut[1]);\r\n    \r\n    return output;\r\n}",
