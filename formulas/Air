    "Source": "\/*\r\n    Author or source: antoinec <antoine.champion+dsp@outlook.fr>\r\n*\/\r\n\r\n \r\ntypedef struct {\r\n    double thres, ratio, atk, rel;\r\n    double makeup, rmsSize;\r\n\r\n    double rmsBuf[10000];\r\n    double rmsSum; \r\n\tint rmsPtr;\r\n    double yold;\r\n} CompState;\r\n\r\ntypedef struct {\r\n    double c[2][2][6];\r\n    double zIn[2][2][2];\r\n    double zOut[2][2][2];\r\n} LRState;\r\n\r\ntypedef struct {\r\n    double a0, a1, a2, b0, b1, b2;\r\n    double zIn[2];\r\n    double zOut[2];\r\n} PkState;\r\n\r\ndouble prevAmount = -1.0;\r\n\r\nLRState xover = {{0}};\r\nCompState comp = {{0}};\r\nPkState peaks[2] = {{0}};\r\n\r\ndouble computeRms(double input, CompState* s) {\r\n    s->rmsSum -= s->rmsBuf[s->rmsPtr];\r\n    s->rmsBuf[s->rmsPtr] = input*input\/s->rmsSize;    \r\n    s->rmsSum += s->rmsBuf[s->rmsPtr++];\r\n    \r\n    if (s->rmsPtr > s->rmsSize) {\r\n        s->rmsPtr = 0;\r\n    }\r\n    \r\n    double rms = sqrt(s->rmsSum);\r\n\t\r\n\treturn rms;\r\n}\r\n\r\nfloat compress(double input, CompState* s) {    \r\n    double rms = computeRms(input, s);  \r\n    \r\n    double x = fabs(rms);\r\n    double cte = x < s->yold ? s->atk : s->rel;\r\n    double y = x + cte * (s->yold - x);\r\n    s->yold = y;\r\n    \r\n    double gain = 1.0;\r\n    if (y < s->thres) {\r\n        gain = pow (y \/ s->thres, 1.0 \/ s->ratio - 1.0);\r\n    }    \r\n    \r\n    return gain * input * s->makeup; \r\n}\r\n\r\nvoid updateComp(CompState* s, float thresDb, float ratio, float atkMs, float relMs, float makeupDb, float rmsSize) {\r\n    s->thres = pow (10.0, thresDb * 0.05);\r\n    s->ratio = ratio;\r\n    double scaling = -2.0 * M_PI * 1000.0 \/ SAMPLE_RATE;\r\n    s->atk = exp(scaling \/ atkMs);\r\n    s->rel = exp(scaling \/ relMs);\r\n    s->makeup = pow (10.0, makeupDb * 0.05);\r\n    s->rmsSize = rmsSize;\r\n}\r\n\r\nLRState xOver(double input, double* outLow, double* outHigh, LRState state) {\r\n    \r\n    double inLow = input;\r\n    for (int order = 0; order < 2; order++) {\r\n        double *a = state.c[0][order], *b = state.c[0][order] + 3;\r\n        double *i = state.zIn[0][order], *o = state.zOut[0][order];\r\n        *outLow = (b[0]*inLow + b[1]*i[0] + b[2]*i[1] - a[1]*o[0] - a[2]*o[1]) \/ a[0];\r\n        i[1] = i[0]; i[0] = inLow;\r\n        o[1] = o[0]; o[0] = *outLow;\r\n        inLow = *outLow;\r\n    }\r\n    \r\n    double inHigh = input;\r\n    for (int order = 0; order < 2; order++) {\r\n        double *a = state.c[1][order], *b = state.c[1][order] + 3;\r\n        double *i = state.zIn[1][order], *o = state.zOut[1][order];\r\n        *outHigh = (b[0]*inHigh + b[1]*i[0] + b[2]*i[1] - a[1]*o[0] - a[2]*o[1]) \/ a[0];\r\n        i[1] = i[0]; i[0] = inHigh;\r\n        o[1] = o[0]; o[0] = *outHigh;\r\n        inHigh = *outHigh;\r\n    }\r\n    return state;\r\n}\r\n\r\nLRState lr4(double cutoff, LRState state) {\r\n    double Q = 1 \/ sqrt(2);\r\n    for (int i = 0; i < 2; ++i)\r\n    {\r\n        double w0 = 2 * M_PI * cutoff \/ SAMPLE_RATE;\r\n        double alpha = sin(w0) \/ (2*Q);\r\n        double cw = cos(w0);\r\n        \r\n        state.c[1][i][0] = state.c[0][i][0] = 1 + alpha;\r\n        state.c[1][i][1] = state.c[0][i][1] = -2 * cw;\r\n        state.c[1][i][2] = state.c[0][i][2] = 1 - alpha;        \r\n        state.c[0][i][3] = 0.5 * (1 - cw);\r\n        state.c[1][i][3] = 0.5 * (1 + cw);\r\n        state.c[0][i][4] = 1 - cw;\r\n        state.c[1][i][4] = -1 - cw;\r\n        state.c[0][i][5] = 0.5 * (1 - cw);\r\n        state.c[1][i][5] = 0.5 * (1 + cw);\r\n    }\r\n    \r\n    return state;\r\n}\r\n\nvoid makePeak(double frequency, double Q, double gain, PkState* s) {\r\n    double w = 2 * M_PI * frequency \/ SAMPLE_RATE;\r\n    gain = pow(10, gain * 0.05);\r\n    \r\n    double cw = cos(w);\r\n    double sw = sin(w);\r\n    double G = 1\/sqrt(gain);\r\n    \r\n    s->a0 = 1 + sw\/(2*Q) \/ G;\r\n    s->a1 = -2*cw;\r\n    s->a2 = 1 - sw\/(2*Q) \/ G;    \r\n    s->b0 = 1 + sw\/(2*Q) * G;\r\n    s->b1 = -2*cw;\r\n    s->b2 = 1 - sw\/(2*Q) * G;\n}\r\n\r\nfloat processPeak(double input, PkState* s) {    \r\n    double output = s->a0*input + s->a1*s->zIn[0] + s->a2*s->zIn[1];\r\n    output -= s->b1*s->zOut[0] + s->b2*s->zOut[1];\r\n    output \/= s->b0;\r\n    \r\n    s->zIn[1] = s->zIn[0]; s->zIn[0] = input;\r\n    s->zOut[1] = s->zOut[0]; s->zOut[0] = output;\r\n    \n    return output;\r\n}\n\r\nformula_main {\r\n\r\n    double amount = KNOB_1;\r\n    \r\n    if (amount != prevAmount) {\r\n        prevAmount = amount;\r\n        \r\n        xover = lr4(8000, xover);\r\n        updateComp(&comp, -30.0+10.0*(1.0-amount), 15, \r\n                100, 1000, -7, 10 );\r\n        makePeak(11000, 2, 4, &peaks[0]);\r\n        makePeak(8000, 0.5, -1.3, &peaks[1]);\r\n    }\r\n    \r\n    double bypass, air;\r\n    \r\n    xover = xOver(input, &bypass, &air, xover);\r\n    \r\n    air += 10e-40;\r\n    double airComp = compress(air, &comp);\r\n    \r\n    air = air*(0.8 + 0.2*(1-amount))  + airComp*0.2*amount;\r\n    \r\n    air = amount*processPeak(air, &peaks[0]) + (1.0-amount)*air;\r\n    air = amount*processPeak(air, &peaks[1]) + (1.0-amount)*air;\r\n    \r\n    return bypass + air;\r\n}\r\n",
