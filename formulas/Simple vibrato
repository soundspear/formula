    "Source": "\/*\r\n    Author or source: antoinec <antoine.champion+dsp@outlook.fr>\r\n*\/\r\n\r\n\/* Vibrato effect, aka pitch modulator,\r\n * with variable speed and width.\r\n *\r\n * Vibrato are simply delays with a variable playback speed.\r\n * The playback speed is modulated using a LFO that controls the\r\n * head reading the delay buffer. \r\n *\/\r\n\r\n\r\nfloat buffer[1000000];\r\nint bufferLength = 1000000;\r\nint bufferWritePtr = 0;\r\nfloat phase = 0;\r\n\r\n\/\/ Linear interpolation in an circular array \r\nfloat lerp_circular(float* arr, int arrSize, int from, float fract) {\r\n    int to = (from + 1) % arrSize;\r\n      \r\n    return (1-fract)*buffer[from] + fract*buffer[to];\r\n}\r\n\r\nformula_main {\r\n    float frequency = exp(-2.3 + KNOB_1*6);\r\n    float width = KNOB_2 * 0.01;\r\n    \r\n    float delay = width * (0.5 + 0.5*sin(2.0 * M_PI * phase));\r\n    float bufferReadPtr = fmodf((float)bufferWritePtr - delay * SAMPLE_RATE + bufferLength - 3.0, (float)bufferLength);\r\n                    \r\n    float fract = bufferReadPtr - (int)(bufferReadPtr);\r\n    float interpolated = lerp_circular(buffer, bufferLength, bufferReadPtr, fract);\r\n    \r\n    buffer[bufferWritePtr++] = input;\r\n    if (bufferWritePtr >= bufferLength) {\r\n        bufferWritePtr = 0;\r\n    }\r\n    \r\n    phase += frequency \/ SAMPLE_RATE;\r\n    if (phase > 1.0) {\r\n        phase -= 1;\r\n    }\r\n    \r\n    return interpolated;    \r\n}\r\n",
