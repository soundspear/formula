    "Source": "\/*\r\n    Author or source: antoinec <antoine.champion+dsp@outlook.fr>\r\n*\/\r\n\r\n\/* Modern parametric EQ with adujstable gains, frequencies and Q factors. *\/\r\n\r\nvoid filter(float frequency, float Q, float gain, float outCoefficients[6]) {\r\n    float w = 2 * M_PI * frequency \/ SAMPLE_RATE;\r\n\tgain = pow(10, gain * 0.05);\r\n    \r\n    float cw = cos(w);\r\n    float sw = sin(w);\r\n    float G = 1\/sqrt(gain);\r\n    \r\n    float *a = outCoefficients;\r\n    float *b = outCoefficients + 3;\r\n    a[0] = 1 + sw\/(2*Q) \/ G, a[1] = -2*cw, a[2] = 1 - sw\/(2*Q) \/ G;    \r\n    b[0] = 1 + sw\/(2*Q) * G, b[1] = -2*cw, b[2] = 1 - sw\/(2*Q) * G;\r\n}\r\n\r\n\r\nfloat process(float input, float coefficients[6], float zIn[2], float zOut[2]) {\r\n    float *a = coefficients;\r\n    float *b = coefficients + 3;\r\n        \r\n    float output = a[0]*input + a[1]*zIn[0] + a[2]*zIn[1];\r\n    output -= b[1]*zOut[0] + b[2]*zOut[1];\r\n    output \/= b[0];\r\n    \r\n    zIn[1] = zIn[0]; zIn[0] = input;\r\n    zOut[1] = zOut[0]; zOut[0] = output;\r\n    \r\n    return output;\r\n}\r\n\r\n\r\nfloat zIn[4][2] = {{0}}, zOut[4][2] = {{0}}, coeff[4][6] = {{0}};\r\n\r\nfloat previousKnobs[12] = {-1};\r\n\r\nformula_main {\r\n    float knobs[12] = {\r\n        KNOB_1, KNOB_2, KNOB_3, KNOB_4, KNOB_5, KNOB_6,\r\n        KNOB_7, KNOB_8, KNOB_9, KNOB_10, KNOB_11, KNOB_12\r\n    };\r\n    \r\n    float output = input;\r\n    for (int i = 0; i < 12; i += 3) {\r\n        int n = i \/ 3; \r\n        if (knobs[i]   != previousKnobs[i] || \r\n            knobs[i+1] != previousKnobs[i+1] ||\r\n            knobs[i+2] != previousKnobs[i+2]) {\r\n            \r\n            previousKnobs[i] = knobs[i];\r\n            previousKnobs[i+1] = knobs[i+1];\r\n            previousKnobs[i+2] = knobs[i+2];\r\n            \r\n            float frequency = exp(3.6 + knobs[i] * 6.1);\r\n            float Q = 0.1 + knobs[i+1] * 2;\r\n            float gain = -12 + knobs[i+2] * 24;\r\n            \r\n            filter(frequency, Q, gain, coeff[n]);\r\n        }\r\n        output = process(output, coeff[n], zIn[n], zOut[n]);\r\n    }\r\n    \r\n    return output;\r\n}",
