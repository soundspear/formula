    "Source": "\/*\r\n    Author or source: antoinec <antoine.champion+dsp@outlook.fr>\r\n*\/\r\n\r\n\r\n\/* \r\n    Neve 1064 Series Preamp\r\n*\/\r\n\r\nfloat ker[9] = { 0.80933, 0.19205, -0.02289, 0.00345, -0.00046, -0.00052, 0.00049, -0.00021 };\r\nfloat buf[9] = {0};\r\n\r\nfloat shape[60] = { 0.0, 0.00262, 0.02386, 0.04206, 0.05822, 0.07526, 0.0918, 0.10858, 0.1253, 0.14196, 0.1587, 0.17536, 0.19208, 0.2088, 0.22552, 0.24218, 0.25892, 0.27564, 0.29236, 0.30902, 0.32574, 0.3424, 0.35914, 0.37586, 0.39258, 0.40924, 0.42596, 0.44268, 0.45942, 0.47608, 0.4928, 0.50952, 0.52618, 0.5429, 0.55964, 0.57636, 0.59302, 0.60968, 0.62646, 0.64312, 0.6598, 0.67658, 0.69324, 0.70996, 0.72668, 0.7434, 0.76014, 0.7768, 0.79352, 0.81024, 0.8269, 0.84362, 0.8603, 0.87702, 0.89368, 0.91028, 0.9284, 0.93896, 0.9737, 0.94904 };\r\nint shapeSize = 60;\r\n\r\nfloat lerp(float* arr, int arrSize, int from, float fract, float yStep) {\r\n    if (from > arrSize) {\r\n        return arr[arrSize - 1] + (from - arrSize)*yStep + fract;\r\n    }\r\n    return (1-fract)*arr[from] + fract*arr[from+1];\r\n}\r\n\nformula_main {\r\n    int size = 9;\r\n    float drive = KNOB_1 * 1000;\n    float output = input;\r\n    \r\n    for (int count = size; count > 0; --count) {\r\n        buf[count] = buf[count-1];\r\n    }\r\n    buf[0] = input;\r\n    \r\n    for (int i = 0; i < size; i++) {\r\n        output += buf[i] * ker[i] * drive;\r\n    }\r\n    \n    output = output \/ (1.0 + drive);\r\n    \r\n    float postConvOutput = output;\r\n    \r\n    int neg = output < 0;\r\n    output = fabs(output);\r\n    \r\n    float step = 0.016667;\r\n    float x = output \/ step;\r\n    int xInt = (int)(x);\r\n    float xFract = x - xInt;\r\n    \r\n    output = lerp(shape, shapeSize, xInt, xFract, step);\r\n    if (neg) output = -output;\r\n    \r\n    output = postConvOutput * (1.0 - KNOB_1*0.6) + output * (KNOB_1*0.6);\r\n    \r\n    return output;\r\n    \n}\n",
