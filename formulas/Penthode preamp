    "Source": "\/*\r\n    Author or source: antoinec <antoine.champion+dsp@outlook.fr>\r\n*\/\r\n\r\n\r\nconst double splines[2][3][4] = {\n\t{\r\n\t\t{-3.308127883567424,-7.809443702583553e-62,+2.5694061565714494,+0},\r\n\t\t{+4.88885654535546,-8.852743183236715,+5.756393702536666,-0.3824385055158261},\r\n\t\t{+0.6759388259136736,-2.0278164777410206,+2.070933281568992,+0.2809443702583554}\r\n\t},\r\n\t{\r\n\t\t{-4.0393616821250475,-8.213832115774964e-63,+1.5196193225570693,+0},\r\n\t\t{+3.6960862095309146,-5.569522481992293,+2.85630471823522,-0.10693483165425202},\r\n\t\t{-0.058156067068031676,+0.17446820120409504,-0.07313053019493816,+0.3910691605788748}\r\n\t}\r\n};\r\n\r\nconst double domains[2][3] = {\r\n    {0.36, 0.54, 1},\r\n    {0.24, 0.51, 1}\r\n};\r\n\r\nfloat y[2] = {0};\r\n\nformula_main {\r\n    float bias = KNOB_1;\r\n    \r\n    int neg = input < 0;\r\n    input = fabs(input);\r\n    float x[4] = {input*input*input, input*input, input, 1};\r\n    \r\n    for (int i = 0; i < 2; i++) {\r\n        y[i] = 0;\r\n        for (int j = 0; j < 3; j++) {\r\n            if (input > domains[i][j]) {\r\n                continue;\r\n            }\r\n            \r\n            for (int c = 0; c < 4; c++) {\r\n                y[i] += x[c] * splines[i][j][c];\r\n            }\r\n            break;\r\n        }\r\n    }\r\n    \r\n    float output = y[0]*0.5 * (1-bias) + y[1]*bias;\r\n    if (neg) {\r\n        output = -output;\r\n    }\n    return output;\n}\n",
