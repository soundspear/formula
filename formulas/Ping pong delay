    "Source": "\/*\r\n    Author or source: antoinec <antoine.champion+dsp@outlook.fr>\r\n*\/\r\n\r\n\/* Stereo delay alternating between left and right \r\n * channels with tunable damping and stereo depth *\/\r\n\r\nfloat filterBuffer = 0;\r\nfloat delayBuffer[1000000];\r\nint bufferPtr = 0;\r\n\r\n\/\/ Low pass filtering\r\nfloat damp(float amount, float input) {\r\n\r\n    float frequency = exp(amount*10);\r\n    float coeff = 2 * M_PI * frequency \/ SAMPLE_RATE;\r\n    coeff = coeff \/ (1 + coeff);\r\n    \r\n    float damped = coeff * input + (1 - coeff) * filterBuffer;\r\n    filterBuffer = damped;\r\n    \r\n    return damped;\r\n}\r\n\nformula_main_stereo {       \r\n    float inputMono = (input.left + input.right) \/ 2;\r\n    float outputMono = delayBuffer[bufferPtr];\r\n    \r\n    int delayBufferSize = SAMPLE_RATE * KNOB_1;\r\n    float feedback = KNOB_2;\r\n    float dampedOutputMono = damp(KNOB_3, outputMono);\r\n    float depth = KNOB_4;    \r\n    \r\n    \/\/ delay buffer is mono, stereo ping-pong is applied on the output\r\n    delayBuffer[bufferPtr] = inputMono + dampedOutputMono * feedback;\r\n    \r\n    \/\/ max(knob_1) = 1 second => freq = 2\/knob_1\r\n    float sw = 0.5 * sin(M_PI \/ KNOB_1 * TIME) + 0.5;\r\n    Stereo output = input;\r\n    output.left += (sw * depth + 1 - depth) * dampedOutputMono * feedback;\r\n    output.right += ((1-sw) * depth + 1 - depth) * dampedOutputMono * feedback;    \r\n    \r\n    bufferPtr++;\r\n    if (bufferPtr > delayBufferSize) {\r\n        bufferPtr = 0;\r\n    }\r\n    \r\n    return output;\r\n}\n",
