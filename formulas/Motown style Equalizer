    "Source": "\/*\r\n    Author or source: antoinec <antoine.champion+dsp@outlook.fr>\r\n*\/\r\n\r\n\n\/*\n    Reproduction of a passive EQ from Motown studios\n*\/\r\n\r\nconst double splines[11][4] = {\r\n\t{-0.001225889724379814, -0.029421353385115534, -0.2610044862281726, -0.46272481206045146},\r\n\t{+0.003232064856398003, +0.037447965326551716, +0.07334210733016365, +0.09451951053677564},\r\n\t{-0.07466985323728155, -0.4767046940917333, -1.0577937433900635, -0.7349801133247242},\r\n\t{+0.09676624572562648, +0.44905024030797003, +0.6085651385294025, +0.26483521582695535},\r\n\t{-0.01922611468718889, -0.0033199653020099243, +0.02048387123642863, +0.01},\r\n\t{-0.005070070523766697, -0.0033199653020099243, +0.02048387123642863, +0.01},\r\n\t{+0.024436208466772615, -0.05643126748498069, +0.05235065254621109, +0.003626643738043509},\r\n\t{+0.04417637288194112, -0.1334179087041379, +0.15243328613111545, -0.03974249748208171},\r\n\t{-0.11610600720015311, +0.7321069437391711, -1.4055114482668407, +0.8950243431566919},\r\n\t{+0.004298065536607767, -0.0625599363234508, +0.3427556878709275, -0.387038223344338},\r\n\t{-0.00021233852507396696, +0.0050961246017752065, +0.004475383244797382, +0.1767622843658788},\r\n};\r\n\r\nconst double domains[11][2] = {\r\n    {-8, -5},\r\n    {-5, -2.2},\r\n    {-2.2, -1.8},\r\n    {-1.8, -1.3},\r\n    {-1.3, 0},\r\n    {0, 0.6},\r\n    {0.6, 1.3},\r\n    {1.3, 1.8},\r\n    {1.8, 2.2},\r\n    {2.2, 5},\r\n    {5, 8}\r\n};\r\n\r\nconst double frequencies[6] = {\r\n    50, 130, 350, 900, 4000, 10000\r\n};\n\r\n\r\ndouble zIn[6][2] = {{0}}, zOut[6][2] = {{0}}, coeff[6][6] = {{0}};\r\n\r\ndouble previousKnobs[6] = {-1};\r\n\r\ndouble map(double x) {\r\n    for (int i = 0; i < 12; i++) {\r\n        if (x >= domains[i][0] && x <= domains[i][1]) {\r\n            return x*x*x*splines[i][0] + x*x*splines[i][1]\r\n                + x*splines[i][2] + splines[i][3];\r\n        }\r\n    }\r\n    return 0.001;\r\n}\r\nvoid filter(float frequency, float Q, float gain, float outCoefficients[6]) {\r\n    float w = 2 * M_PI * frequency \/ SAMPLE_RATE;\r\n\tgain = pow(10, gain * 0.05);\r\n    \r\n    float cw = cos(w);\r\n    float sw = sin(w);\r\n    float G = 1\/sqrt(gain);\r\n    \r\n    float *a = outCoefficients;\r\n    float *b = outCoefficients + 3;\r\n    a[0] = 1 + sw\/(2*Q) \/ G, a[1] = -2*cw, a[2] = 1 - sw\/(2*Q) \/ G;    \r\n    b[0] = 1 + sw\/(2*Q) * G, b[1] = -2*cw, b[2] = 1 - sw\/(2*Q) * G;\r\n}\r\n\r\n\r\nfloat process(float input, float coefficients[6], float zIn[2], float zOut[2]) {\r\n    float *a = coefficients;\r\n    float *b = coefficients + 3;\r\n        \r\n    float output = a[0]*input + a[1]*zIn[0] + a[2]*zIn[1];\r\n    output -= b[1]*zOut[0] + b[2]*zOut[1];\r\n    output \/= b[0];\r\n    \r\n    zIn[1] = zIn[0]; zIn[0] = input;\r\n    zOut[1] = zOut[0]; zOut[0] = output;\r\n    \r\n    return output;\r\n}\r\n\nformula_main {\r\n    float knobs[6] = {\r\n        KNOB_1, KNOB_2, KNOB_3, KNOB_4, KNOB_5, KNOB_6\r\n    };\r\n    \r\n    float output = input;\r\n    for (int i = 0; i < 6; i++) {\r\n        if (knobs[i] != previousKnobs[i]) {\r\n            \r\n            previousKnobs[i] = knobs[i];\r\n            \r\n            float gain = -8 + knobs[i] * 16;\r\n            float Q = map(gain);\r\n            Q = fmax(0.02, Q)*2;\r\n            \r\n            filter(frequencies[i], Q, gain, coeff[i]);\r\n        }\r\n        \r\n        if (knobs[i] != 0.5f) {\r\n            output = process(output, coeff[i], zIn[i], zOut[i]);\r\n        }\r\n    }\r\n    \n    return output;\n}\n",
