    "Source": "\/*\r\n    Author or source: antoinec <antoine.champion+dsp@outlook.fr>\r\n*\/\r\n\r\n\/* Very simple delay with a duration and a feedback knob.\r\n * The delay buffer is made big enough to store 1 second of\r\n * delay for any sample rate *\/\r\n\r\nfloat delayBuffer[1000000];\r\nint bufferPtr = 0;\r\n\nformula_main {\r\n    float output = delayBuffer[bufferPtr];\r\n    \r\n    \/\/ 1 second max delay\r\n    int delayBufferSize = SAMPLE_RATE * KNOB_1;\r\n    float feedback = KNOB_2;\r\n    \r\n    delayBuffer[bufferPtr] = input + output * feedback;\r\n    \r\n    bufferPtr++;\r\n    if (bufferPtr > delayBufferSize) {\r\n        bufferPtr = 0;\r\n    }\r\n    \r\n    return output;\r\n}\n",
