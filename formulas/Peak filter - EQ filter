    "Source": "\/*\r\n    Author or source: antoinec <antoine.champion+dsp@outlook.fr>\r\n*\/\r\n\r\n\/* Peak filter (2nd order)\r\n * Boost or cut at a given frequency\r\n * Equivalent to gain * bandpass filter + bandstop filter *\/\r\n\r\n\r\nfloat zIn[2] = {0};\r\nfloat zOut[2] = {0};\r\n\nformula_main {\r\n    float frequency = exp(2.3 + KNOB_1 * 7.6);\r\n    float w = 2 * M_PI * frequency \/ SAMPLE_RATE;\n    float Q = 0.001 + KNOB_2 * 5;\r\n    float gain = -8 + KNOB_3 * 16;\r\n    gain = pow(10, gain * 0.05);\r\n    \r\n    float cw = cos(w);\r\n    float sw = sin(w);\r\n    float G = 1\/sqrt(gain);\r\n    \r\n    float a0 = 1 + sw\/(2*Q) \/ G, a1 = -2*cw, a2 = 1 - sw\/(2*Q) \/ G;    \r\n    float b0 = 1 + sw\/(2*Q) * G, b1 = -2*cw, b2 = 1 - sw\/(2*Q) * G;\r\n    \r\n    float output = a0*input + a1*zIn[0] + a2*zIn[1];\r\n    output -= b1*zOut[0] + b2*zOut[1];\r\n    output \/= b0;\r\n    \r\n    zIn[1] = zIn[0]; zIn[0] = input;\r\n    zOut[1] = zOut[0]; zOut[0] = output;\r\n    \n    return output;\n}\n",
