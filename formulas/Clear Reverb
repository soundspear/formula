    "Source": "\/*\r\n    Author or source: antoinec <antoine.champion+dsp@outlook.fr>\r\n*\/\r\n\r\n\/* Algorithmic reverb made from multitap delays \r\n * with decay diffusion. *\/\r\n\r\ntypedef struct {\r\n    float buffer[1000000];\r\n    float bufSize;\r\n    \r\n    int taps[10];\r\n    int numTaps;\r\n    \r\n    float feedback;\r\n} MultitapState;\r\n\r\nfloat multitap(float input, MultitapState* s) {\r\n    int ptr = s->taps[0];\r\n    float temp = input * -s->feedback;\r\n    float output = s->buffer[ptr] + temp;\r\n    s->buffer[ptr] = input + (s->buffer[ptr]+temp)*s->feedback;\r\n    \r\n    for (int i = 0; i < s->numTaps; i++) {\r\n        if (++s->taps[i] >= s->bufSize) {\r\n            s->taps[i] = 0;\r\n        }\r\n    }\r\n    return output;\r\n}\r\n\r\nfloat prevKnobs[3] = {-1};\r\nint knobsChanged() {\r\n    int changed = KNOB_1 != prevKnobs[0] || KNOB_2 != prevKnobs[1] || KNOB_3 != prevKnobs[2];\r\n    prevKnobs[0] = KNOB_1; prevKnobs[1] = KNOB_2; prevKnobs[2] = KNOB_3;\r\n    return changed;\r\n}\r\n\r\nMultitapState s[12] = {{ 0 }};\r\n\r\nfloat initMultitaps(float density, float size, float decay) {\r\n    float density2 = fmin(fmax(decay + 0.15, 0.25), 0.5);\r\n\r\n    \/\/ Single taps\r\n    s[0].bufSize = 0.0048 * SAMPLE_RATE * size;\r\n    s[1].bufSize = 0.0036 * SAMPLE_RATE * size;\r\n    s[2].bufSize = 0.0127 * SAMPLE_RATE * size;\r\n    s[3].bufSize = 0.0093 * SAMPLE_RATE * size;\r\n    s[0].feedback = 0.75;\r\n    s[1].feedback = 0.75;\r\n    s[2].feedback = 0.625;\r\n    s[3].feedback = 0.625;\r\n    s[0].numTaps = s[1].numTaps = s[2].numTaps = s[3].numTaps = 1;\r\n    \r\n    \/\/ 4-taps\r\n    s[4].bufSize = 0.020 * SAMPLE_RATE * size;\r\n    s[5].bufSize = 0.060 * SAMPLE_RATE * size;\r\n    s[6].bufSize = 0.030 * SAMPLE_RATE * size;\r\n    s[7].bufSize = 0.089 * SAMPLE_RATE * size;\r\n    s[4].feedback = density;\r\n    s[5].feedback = density2;\r\n    s[6].feedback = density;\r\n    s[7].feedback = density2;\r\n    s[4].numTaps = s[5].numTaps = s[6].numTaps = s[7].numTaps = 4;\r\n    s[4].taps[0] = 0; s[4].taps[1] = 0; s[4].taps[2] = 0; s[4].taps[3] = 0;\r\n    s[5].taps[0] = 0; s[5].taps[1] = 0.006 * SAMPLE_RATE * size; s[5].taps[2] = 0.041 * SAMPLE_RATE * size; s[5].taps[3] = 0;\r\n    s[6].taps[0] = 0; s[6].taps[1] = 0; s[6].taps[2] = 0; s[6].taps[3] = 0;\r\n    s[7].taps[0] = 0; s[7].taps[1] = 0.031 * SAMPLE_RATE * size; s[7].taps[2] = 0.011 * SAMPLE_RATE * size; s[7].taps[3] = 0;\r\n\r\n    \/\/ 4-taps no feedback\r\n    s[8].bufSize = 0.15 * SAMPLE_RATE * size;\r\n    s[9].bufSize = 0.12 * SAMPLE_RATE * size;\r\n    s[10].bufSize = 0.14 * SAMPLE_RATE * size;\r\n    s[11].bufSize = 0.11 * SAMPLE_RATE * size;\r\n    s[8].feedback = s[9].feedback = s[10].feedback = s[11].feedback = 0;\r\n    s[8].numTaps = s[9].numTaps = s[10].numTaps = s[11].numTaps = 4;\r\n    s[8].taps[0] = 0;  s[8].taps[1] = 0.067 * SAMPLE_RATE * size;   s[8].taps[2] = 0.011 * SAMPLE_RATE * size;   s[8].taps[3] = 0.121;\r\n    s[9].taps[0] = 0;  s[9].taps[1] = 0.036 * SAMPLE_RATE * size;   s[9].taps[2] = 0.089 * SAMPLE_RATE * size;   s[9].taps[3] = 0;\r\n    s[10].taps[0] = 0; s[10].taps[1] = 0.0089 * SAMPLE_RATE * size; s[10].taps[2] = 0.099 * SAMPLE_RATE * size;  s[10].taps[3] = 0;\r\n    s[11].taps[0] = 0; s[11].taps[1] = 0.067 * SAMPLE_RATE * size;  s[11].taps[2] = 0.0041 * SAMPLE_RATE * size; s[11].taps[3] = 0;   \r\n}\r\n\r\nStereo zOut[2] = {{0}};\r\nStereo zIn[2] = {{0}};\r\n\r\nStereo filter(Stereo input, float freq, int highpass) {\r\n    float w = tanf(M_PI * freq \/ SAMPLE_RATE);\r\n    Stereo *zIn_, *zOut_;\r\n\r\n    float a0 = w + 1, a1 = w - 1, b0 = w, b1 = w;\r\n    \r\n    if (highpass) {\r\n        b0 = 1; b1 = -1;\r\n        zIn_ = &zIn[0]; zOut_ = &zOut[0];\r\n    }\r\n    else {\r\n        b0 = w; b1 = w;\r\n        zIn_ = &zIn[1]; zOut_ = &zOut[1];\r\n    }\r\n\r\n    Stereo output;\r\n    output.left = b0 * input.left + b1 * zIn_->left - a1 * zOut_->left;\r\n    output.left \/= a0;\r\n    output.right = b0 * input.right + b1 * zIn_->right - a1 * zOut_->right;\r\n    output.right \/= a0;\r\n    \r\n    *zOut_ = output;\r\n    *zIn_ = input;\r\n\r\n    return output;\r\n}\r\n\r\nStereo previousAcc = {0};\r\n\r\nStereo reverb(Stereo input, float decay, float lpf, float hpf) {\r\n    float mono = (input.left + input.right) * 0.5;\r\n    for (int i = 0; i < 4; i++) {\r\n        mono = multitap(mono, &s[i]);\r\n    }\r\n    \r\n    Stereo acc;\r\n        \r\n    acc.left = multitap(mono + previousAcc.left, &s[4]);\r\n    acc.left = multitap(acc.left, &s[8]);    \r\n    acc.right = multitap(mono + previousAcc.right, &s[6]);\r\n    acc.right = multitap(acc.right, &s[10]);\r\n    \r\n    acc = filter(acc, lpf, 0);\r\n    \r\n    acc.left = multitap(acc.left, &s[5]);\r\n    acc.left = multitap(acc.left, &s[9]);\r\n    acc.right = multitap(acc.right, &s[7]);\r\n    acc.right = multitap(acc.right, &s[11]);\r\n    \r\n    previousAcc.left = acc.left * decay;\r\n    previousAcc.right = acc.right * decay;\r\n    \r\n    Stereo output;\r\n    \r\n    output.left +=  s[10].buffer[s[10].taps[1]];\r\n    output.left +=  s[10].buffer[s[10].taps[2]];\r\n    output.left += -s[7] .buffer[s[7] .taps[1]];\r\n    output.left +=  s[11].buffer[s[11].taps[1]];\r\n    output.left += -s[8] .buffer[s[8] .taps[1]];\r\n    output.left += -s[5] .buffer[s[5] .taps[1]];\r\n    output.left += -s[9] .buffer[s[9] .taps[1]];\r\n    output.left \/= 3;\r\n    \r\n    output.right +=  s[8] .buffer[s[8] .taps[2]];\r\n    output.right +=  s[8] .buffer[s[8] .taps[3]];\r\n    output.right += -s[5] .buffer[s[5] .taps[2]];\r\n    output.right +=  s[9] .buffer[s[9] .taps[2]];\r\n    output.right += -s[10].buffer[s[10].taps[3]];\r\n    output.right += -s[7] .buffer[s[7] .taps[2]];\r\n    output.right += -s[11].buffer[s[11].taps[2]];\r\n    output.right \/= 3;\r\n    \r\n    output = filter(output, hpf, 1);\r\n    \r\n    return output;\r\n}\r\n\r\nformula_main_stereo \r\n{    \r\n    float density = 0.7;\r\n    float intensity = KNOB_1 * 2;\r\n    float decay = fmin(KNOB_2, 0.99);\r\n    float size = KNOB_3;\r\n    float lpf = exp(3.8 + KNOB_4 * 6.1);\r\n    float hpf = exp(3.8 + KNOB_5 * 6.1);\r\n\r\n    if (knobsChanged()) {\r\n        initMultitaps(density, size, decay);\r\n    }\r\n\r\n    Stereo output = reverb(input, decay, lpf, hpf);\r\n    output.left = output.left * intensity + input.left;\r\n    output.right= output.right * intensity + input.right;\r\n    \r\n    return output;\r\n}\r\n",
