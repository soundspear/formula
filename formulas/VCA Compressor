    "Source": "\/*\r\n    Author or source: antoinec <antoine.champion+dsp@outlook.fr>\r\n*\/\r\n\r\n\r\ntypedef struct {\r\n    double thres, ratio, atk, rel;\r\n    double makeup, rmsSize;\r\n\tint isRms, isFeedForward;\r\n\t\r\n    double rmsBuf[10000];\r\n    double rmsSum; \r\n\tint rmsPtr;\r\n\t\r\n    double yold;\r\n    double x;\r\n} CompState;\r\n\r\nfloat prevKnobs[7] = {-1};\r\n\r\nCompState comp = {{0}};\r\n\r\nfloat computeRms(float input, CompState* s) {\r\n    s->rmsSum -= s->rmsBuf[s->rmsPtr];\r\n    s->rmsBuf[s->rmsPtr] = input*input\/s->rmsSize;    \r\n    s->rmsSum += s->rmsBuf[s->rmsPtr++];\r\n    \r\n    if (s->rmsPtr > s->rmsSize) {\r\n        s->rmsPtr = 0;\r\n    }\r\n    \r\n    float rms = sqrt(s->rmsSum);\r\n\t\r\n\treturn rms;\r\n}\r\n\r\nfloat compress(float input, CompState* s) {\r\n\r\n    if (s->isFeedForward) {\r\n        if (s->isRms) {\r\n            s->x = computeRms(input, s);\r\n        }\r\n        else {\r\n            s->x = fabs(input);\r\n        }    \r\n    }\r\n    \r\n    double cte = s->x > s->yold ? s->atk : s->rel;\r\n    double y = s->x + cte * (s->yold - s->x);\r\n    s->yold = y;\r\n    \r\n    double gain = 1.0;\r\n    if (y > s->thres) {\r\n        gain = pow (y \/ s->thres, 1.0 \/ s->ratio - 1.0);\r\n    }\r\n    \r\n    double output = gain * input * s->makeup; \r\n    \r\n    if (!s->isFeedForward) {\r\n        if (s->isRms) {\r\n            s->x = computeRms(input, s);\r\n        }\r\n        else {\r\n            s->x = fabs(input);\r\n        }    \r\n    }\r\n    return output;\r\n}\r\n\r\nvoid updateComp(CompState* s, float thresDb, float ratio, float atkMs, float relMs, \r\n                float makeupDb, float rmsSize, int isRms, int isFeedForward) {\r\n    s->thres = pow (10.0, thresDb * 0.05);\r\n    s->ratio = ratio;\r\n    double scaling = -2.0 * M_PI * 1000.0 \/ SAMPLE_RATE;\r\n    s->atk = exp(scaling \/ atkMs);\r\n    s->rel = exp(scaling \/ relMs);\r\n    s->makeup = pow (10.0, makeupDb * 0.05);\r\n    s->rmsSize = rmsSize;\r\n    s->isRms = isRms;\r\n    s->isFeedForward = isFeedForward;\r\n}\r\n\r\nint knobsChanged() {\r\n    float knobs[7] = {\r\n        KNOB_1, KNOB_2, KNOB_3, KNOB_4, KNOB_5, SWITCH_1, SWITCH_2\r\n    };\r\n    int changed = 0;\r\n    for (int i = 0; i < 7; i++) {\r\n        if (knobs[i] != prevKnobs[i]) {\r\n            changed = 1;\r\n            prevKnobs[i] = knobs[i];\r\n        }\r\n    }\r\n    return changed;\r\n}\r\n\r\nformula_main {\r\n    if (knobsChanged()) {\r\n        float thres = (1 - KNOB_1) * -30;\r\n        float ratio = 1 + KNOB_2 * 9;\r\n        float attack = 1 + KNOB_3 * 99;\r\n        float release = 1 + KNOB_4 * 5000;\r\n        float rms = 1 + KNOB_5 * 100;\r\n        int isRms = SWITCH_1;\r\n        int isFeedForward = !SWITCH_2;\r\n        updateComp(&comp, thres, ratio, attack, release, 0, rms, isRms, isFeedForward);\r\n    }    \r\n    \r\n    float output = compress(input, &comp);\r\n    \r\n    return output;\r\n}\r\n",
