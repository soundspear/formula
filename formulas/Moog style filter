    "Source": "\/*\r\n    Author or source: antoinec <antoine.champion+dsp@outlook.fr>\r\n*\/\r\n\r\n\r\nfloat state[5] = {0};\r\n\r\nformula_main {\r\n\r\n    float cutoff = exp(KNOB_1 * 20000 * -2. * M_PI \/ SAMPLE_RATE);\r\n    float resonance = 0.1 + KNOB_2 * 0.9;\r\n    float drive = 1 + KNOB_3;\r\n\r\n    float drive2 = drive * 0.04 + 0.96;\r\n\r\n    float gain = pow(drive, -2.642) * 0.6103 + 0.3903;\r\n    float gain2 = pow(drive2, -2.642) * 0.6103 + 0.3903;\r\n\r\n    float g = cutoff * -1 + 1;\r\n    float b0 = g * 0.76923076923;\r\n    float b1 = g * 0.23076923076;\r\n\r\n    float dx = gain * tanh (drive * input);\r\n    float a = dx + resonance * -4 * (gain2 * tanh(drive2 * state[4]) - dx * 0.5);\r\n    \r\n    float b = b1 * state[0] + cutoff * state[1] + b0 * a;\r\n    float c = b1 * state[1] + cutoff * state[2] + b0 * b;\r\n    float d = b1 * state[2] + cutoff * state[3] + b0 * c;\r\n    float e = b1 * state[3] + cutoff * state[4] + b0 * d;\r\n\r\n    state[0] = a;\r\n    state[1] = b;\r\n    state[2] = c;\r\n    state[3] = d;\r\n    state[4] = e;\r\n\r\n    return c + e;\r\n}\r\n",
